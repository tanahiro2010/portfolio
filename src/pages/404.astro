---
import Base from "@/layouts/Base.astro";
---

<Base title="404 — Not Found | tanahiro2010" noindex={true}>
  <main
    id="main"
    class="mx-auto flex min-h-screen max-w-2xl flex-col items-center justify-center px-5 text-center"
  >
    <p class="eyebrow">Error</p>
    <h1 class="mt-4 text-7xl sm:text-8xl">404</h1>
    <p class="mt-4 text-lg text-muted">
      お探しのページは見つかりませんでした。
    </p>
    <a
      href="/"
      class="mt-10 inline-flex items-center gap-2 bg-ink px-6 py-3 text-sm font-medium uppercase tracking-widest text-paper transition-colors hover:bg-accent"
    >
      ← Back to home
    </a>
  </main>
</Base>
