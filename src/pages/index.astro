---
import Base from "@/layouts/Base.astro";
// 本文は src/data/home.md に書く。ここではデザインを当てるだけ。
import { Content } from "@/data/home.md";

const title = "Hirohisa Tanaka / tanahiro2010";
const description =
  "Hirohisa Tanaka / tanahiro2010. Web Application Developer in training, novelist, and community organizer.";
---

<Base title={title} description={description}>
  <main id="main">
    <Content />

    <footer>© Hirohisa Tanaka</footer>
  </main>
</Base>

<style is:global>
  :root {
    color-scheme: light;
    --text: #111;
    --muted: #555;
    --border: #ddd;
    --bg: rgb(255, 255, 255);
    --link: #0645ad;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    background-color: var(--bg);
    font-family:
      system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 16px;
    line-height: 1.7;
    /* global.css の設定を打ち消してブラウザ標準に戻す */
    -webkit-font-smoothing: auto;
    text-rendering: auto;
    font-feature-settings: normal;
  }

  ::selection {
    background: highlight;
    color: highlighttext;
  }

  main {
    width: min(720px, calc(100% - 32px));
    margin: 40px auto 56px;
  }

  main h1,
  main h2 {
    line-height: 1.25;
    /* global.css のセリフ体・細字を打ち消す */
    font-family: inherit;
    font-weight: bold;
    letter-spacing: normal;
  }

  main h1 {
    margin: 0 0 8px;
    font-size: 2rem;
  }

  main h2 {
    margin: 32px 0 8px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    font-size: 1.25rem;
  }

  main p {
    margin: 0 0 12px;
  }

  main ul {
    margin: 0;
    padding-left: 1.4rem;
    /* preflight で消えるリストの点を戻す */
    list-style: disc;
  }

  main li {
    margin: 4px 0;
  }

  main a {
    color: var(--link);
    /* preflight で消える下線を戻す */
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  main strong {
    font-weight: bold;
  }

  /* 名前直後の段落 = リード文 (.lead) */
  main h1 + p {
    color: var(--muted);
  }

  /* リード文直後のリスト = アカウントリンクの横並び (.links) */
  main h1 + p + ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    margin: 12px 0 24px;
    padding: 0;
    list-style: none;
  }

  main h1 + p + ul li {
    margin: 0;
  }

  .meta {
    color: var(--muted);
  }

  main footer {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
