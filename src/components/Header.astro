---
import { nav, site } from "@/data/site";

// 狭い画面では主要な導線 (Works / Contact) のみ表示する
const alwaysVisible = new Set(["Works", "Contact"]);
---

<header
  class="sticky top-0 z-40 border-b border-line/70 bg-paper/85 backdrop-blur-md"
>
  <div
    class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-5 sm:px-8"
  >
    <a
      href="/"
      class="shrink-0 font-serif text-lg tracking-tight transition-opacity hover:opacity-60 sm:text-xl"
    >
      {site.name}
    </a>

    <nav
      aria-label="Primary"
      class="flex items-center gap-3.5 text-xs sm:gap-6 sm:text-sm"
    >
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "link-underline text-muted transition-colors hover:text-ink",
              !alwaysVisible.has(item.label) && "hidden sm:inline",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
