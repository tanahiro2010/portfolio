---
import { site } from "@/data/site";
import { LINKS } from "@/data/links";

const year = 2026;
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto max-w-5xl px-5 py-12 sm:px-8">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="font-serif text-2xl">{site.name}</p>
        <p class="mt-1 text-sm text-muted">{site.role}</p>
      </div>

      <nav aria-label="Social" class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
        {
          LINKS.slice(0, 5).map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="link-underline text-muted transition-colors hover:text-ink"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <p class="mt-10 text-xs tracking-wide text-muted">
      © {year} {site.name}. All rights reserved.
    </p>
  </div>
</footer>
